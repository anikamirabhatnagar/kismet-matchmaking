:80 {
	root * .
	file_server
	try_files {path} {path}/ /index.html
	
	# Enable compression
	encode gzip
	
	# Set proper MIME types
	@html path *.html
	header @html Content-Type "text/html; charset=utf-8"
	
	@css path *.css
	header @css Content-Type "text/css; charset=utf-8"
	
	@js path *.js
	header @js Content-Type "application/javascript; charset=utf-8"
	
	# Cache static assets
	@static path *.jpg *.jpeg *.png *.gif *.ico *.svg *.css *.js *.woff *.woff2 *.mp4
	header @static Cache-Control "public, max-age=31536000"
}